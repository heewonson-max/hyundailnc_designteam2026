rules_version = '2';

// Secret Manitto · Firestore 보안 규칙
// 1) 아래 admin@example.com 을 관리자 이메일로 바꾸세요 (firebase-config.js의 adminEmails와 같게).
// 2) Firebase 콘솔 > Firestore Database > 규칙 탭에 전체를 붙여 넣고 [게시]를 누르세요.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ["admin@example.com"];
    }

    // 일정과 배정은 관리자만 바꿉니다. 배정(assign)은 사람마다 암호화되어 있어 읽어도 내용을 알 수 없습니다.
    match /config/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /assign/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // 참가 신청서: 누구나 새로 낼 수 있고, 삭제는 관리자만.
    match /entries/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // 참가자 활동 데이터
    match /pstate/{id}   { allow read, create, update: if signedIn(); allow delete: if isAdmin(); }
    match /scores/{id}   { allow read, create, update: if signedIn(); allow delete: if isAdmin(); }
    match /guesses/{id}  { allow read, create, update: if signedIn(); allow delete: if isAdmin(); }
    match /likes/{id}    { allow read, create, update: if signedIn(); allow delete: if isAdmin(); }
    match /reveal/{id}   { allow read, create, update: if signedIn(); allow delete: if isAdmin(); }
    match /posts/{id}    { allow read, create: if signedIn(); allow update, delete: if isAdmin(); }
    match /comments/{id} { allow read, create: if signedIn(); allow update, delete: if isAdmin(); }
    match /receipts/{pid}/items/{id} { allow read, create: if signedIn(); allow update, delete: if isAdmin(); }
  }
}
